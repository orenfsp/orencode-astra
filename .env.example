POSTGRES_DB=fsp
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fsp:fsp@localhost:5432/fsp
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
ADMIN_REGISTRATION_CODE=replace-with-a-long-local-admin-code

# Admin is never created automatically. Pass these only to `python -m app.create_admin`.
# ADMIN_EMAIL=admin@example.test
# ADMIN_PASSWORD=replace-with-a-long-local-password

# Email-уведомления. В Docker Compose по умолчанию уходят в Mailpit (http://localhost:8025).
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ФСП Оренбург <noreply@example.ru>
APP_URL=http://localhost:5173
