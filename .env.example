# Скопируйте в .env: cp .env.example .env (без .env всё тоже запустится со значениями по умолчанию).

# PostgreSQL в Docker. Порт на компьютере — 5433, чтобы не конфликтовать с установленным PostgreSQL.
POSTGRES_DB=fsp
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_PORT=5433
# Нужен только при запуске backend без Docker против базы из Docker.
DATABASE_URL=postgresql+asyncpg://fsp:fsp@localhost:5433/fsp

# Порт сайта: http://localhost:8080
FRONTEND_PORT=8080
# Адрес сайта для ссылок в письмах и QR-кодах справок.
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
UPLOAD_DIR=uploads

# Код для регистрации сотрудника федерации через форму «Регистрация» (роль «Сотрудник федерации»).
ADMIN_REGISTRATION_CODE=replace-with-a-long-local-admin-code

# Администратор не создаётся автоматически. Эти переменные передаются только команде python -m app.create_admin.
# ADMIN_EMAIL=admin@example.test
# ADMIN_PASSWORD=replace-with-a-long-local-password

# Email-уведомления. В Docker Compose по умолчанию уходят в Mailpit (http://localhost:8025).
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ФСП Оренбург <noreply@example.ru>

# Демо-данные (вымышленные) загружаются при старте backend: 1 — загрузить, 0 — чистая база.
DEMO_DATA=1
DEMO_PASSWORD=Demo-Password-2026
