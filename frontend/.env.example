# Обычно ничего менять не нужно: в режиме разработки Vite проксирует /api на backend (http://127.0.0.1:8002).
# Другой адрес backend для прокси задаётся переменной окружения BACKEND_URL при запуске npm run dev.
# VITE_API_URL нужен, только если API живёт на другом домене (тогда настройте CORS и cookie на backend).
# VITE_API_URL=https://api.example.ru
